# Phone and transport. Keep the current feasibility sockets on loopback only.
PHONE_AGENT_DEVICE_ID=rgr8r8zxmv9txgi7
PHONE_AGENT_CONTROL_HOST=127.0.0.1
PHONE_AGENT_CONTROL_PORT=8765
PHONE_AGENT_RX_PORT=8766
PHONE_AGENT_TX_PORT=8767
PHONE_AGENT_SAMPLE_RATE=16000
PHONE_AGENT_FRAME_MS=20
PHONE_AGENT_INPUT_QUEUE_FRAMES=25

# Safety defaults. Production auto-answer remains disabled until caller policy exists.
PHONE_AGENT_AUTO_ANSWER=false
PHONE_AGENT_MEMORY_ENABLED=true
PHONE_AGENT_IDENTITY_ROOT=~/.config/phone-agent/identity
PHONE_AGENT_IDENTITY_MEMORY_DB=~/.local/share/phone-agent/identity-memory.sqlite3
# Production activation requires isolated gpt-realtime behavioral cases after
# deterministic contract evaluation. Disable only for offline development.
PHONE_AGENT_IDENTITY_PROPOSALS_ENABLED=true
# Optional asynchronous Graphiti REST mirror. Local SQLite remains authoritative
# and every mirror failure is isolated from the call/audio path.
PHONE_AGENT_GRAPHITI_URL=
PHONE_AGENT_GRAPHITI_TOKEN=
PHONE_AGENT_GRAPHITI_ALLOWED_HOSTS=
PHONE_AGENT_TASK_ID=customer_support
PHONE_AGENT_EVENT_STREAM=false
PHONE_AGENT_VOICE_LOCK_PATH=~/.local/share/phone-agent/voice-host.lock
# Keep one voice host warm so an outbound dial reuses already-loaded speech
# models. The host loads SenseVoice and Kokoro into its own CUDA context, which
# measures ~23 s on an A6000; without this that cost is paid on every call,
# before the phone even rings. Turn it off for tests or for a Studio that only
# serves the HTTP surface. Whether the warm host also *answers* incoming calls
# stays controlled by the auto-answer toggle, not by this flag.
PHONE_AGENT_WARM_VOICE_HOST=true
PHONE_AGENT_WEB_HOST=127.0.0.1
PHONE_AGENT_WEB_PORT=8090
# Call recording is controlled by per-call recording consent in Studio/MCP.
PHONE_AGENT_PIPECAT_LOG_LEVEL=INFO

# Generate at least 32 random bytes and base64-encode them for the framed protocol.
# Do not commit the real value. The current raw Android sockets do not consume it yet.
PHONE_AGENT_LINK_KEY_BASE64=

# Replaceable production cascade.
# parakeet_local runs NVIDIA Parakeet TDT v3 on this Mac: no credentials, no
# network, and no provider-final dependency, which removes the 1800 ms
# antigravity fallback floor. English and French only.
PHONE_AGENT_STT_PROVIDER=antigravity_live
PHONE_AGENT_STT_MODEL=gemini-3.1-flash-live-preview
PHONE_AGENT_STT_LANGUAGE=en-US

# Direct OpenAI Realtime speech-to-speech mode. The preferred language controls
# the opening; each later turn follows the caller's detected English/French.
# Carrier downlink is already processed, so additional Realtime noise reduction
# is disabled by default instead of applying close-microphone filtering twice.
PHONE_AGENT_PIPELINE_MODE=s2s_chatgpt_realtime
PHONE_AGENT_CHATGPT_VOICE=marin
PHONE_AGENT_CHATGPT_MODEL=auto
PHONE_AGENT_CHATGPT_TRANSPORT=websocket
PHONE_AGENT_CHATGPT_REASONING_EFFORT=low
PHONE_AGENT_CHATGPT_TRANSCRIPTION_MODEL=gpt-live-transcribe
PHONE_AGENT_CHATGPT_INPUT_LANGUAGES=en,fr
PHONE_AGENT_CHATGPT_NOISE_REDUCTION=off
PHONE_AGENT_CHATGPT_VAD_MODE=server_vad
PHONE_AGENT_CHATGPT_VAD_THRESHOLD=0.5
PHONE_AGENT_CHATGPT_VAD_PREFIX_MS=300
PHONE_AGENT_CHATGPT_VAD_SILENCE_MS=700
# Used only when PHONE_AGENT_CHATGPT_VAD_MODE=semantic_vad.
PHONE_AGENT_CHATGPT_VAD_EAGERNESS=medium
# Re-engage the caller after this much silence. The Realtime server enforces a
# 5000 ms floor; 0 disables the check-in entirely.
PHONE_AGENT_CHATGPT_IDLE_TIMEOUT_MS=8000
# Playback rate for generated speech, 0.8-2.0. This changes delivery speed only;
# how much the agent says is steered by the persona instructions.
PHONE_AGENT_CHATGPT_SPEED=1.05
# Low values respond faster; higher values are more conservative.
PHONE_AGENT_FLUX_EAGER_EOT_THRESHOLD=0.55
PHONE_AGENT_FLUX_EOT_THRESHOLD=0.70
PHONE_AGENT_FLUX_EOT_TIMEOUT_MS=1600
# Antigravity Live waits for stable transcripts and acoustic turn completion.
# Complete turns get 600 ms; unknown decisions get 900 ms; unfinished thoughts
# have up to 3000 ms to continue. These are starting values for call calibration.
PHONE_AGENT_ANTIGRAVITY_CHUNK_MS=200
PHONE_AGENT_ANTIGRAVITY_ENDPOINT_MS=600
PHONE_AGENT_ANTIGRAVITY_INCOMPLETE_ENDPOINT_MS=3000
PHONE_AGENT_ANTIGRAVITY_STABILITY_MS=100
PHONE_AGENT_ANTIGRAVITY_FALLBACK_ENDPOINT_MS=900
PHONE_AGENT_ANTIGRAVITY_CONTEXT_BIAS=Natural bilingual English and French telephone conversation. Preserve complete sentences, names, numbers, dates, and addresses without translation.
PHONE_AGENT_SMART_TURN_ENABLED=true
# Empty uses Pipecat's bundled Smart Turn v3.2 CPU model.
PHONE_AGENT_SMART_TURN_MODEL_PATH=
# Native model decision boundary; calibrate against labelled call audio before
# changing it. Valid values are greater than 0 and at most 1.
PHONE_AGENT_SMART_TURN_COMPLETION_THRESHOLD=0.5
# Optional early answer preparation. Resumed speech or a transcript revision
# discards the candidate; prefetch never grants permission to speak sooner.
PHONE_AGENT_SPECULATIVE_PIPELINE=false
PHONE_AGENT_SPECULATIVE_PREFETCH_SILENCE_MS=120
PHONE_AGENT_SPECULATIVE_PREFETCH_STABILITY_MS=80
# Legacy speculation timing controls cannot shorten the base turn boundaries.
PHONE_AGENT_SPECULATIVE_FAST_ENDPOINT_MS=600
PHONE_AGENT_SPECULATIVE_AMBIGUOUS_ENDPOINT_MS=900
PHONE_AGENT_SPECULATIVE_INCOMPLETE_ENDPOINT_MS=3000
PHONE_AGENT_SPECULATIVE_COMMIT_WAIT_MS=100
# Cached acknowledgement audio is opt-in to avoid a generic reaction before
# each response. Normal model responses and interruption handling stay active.
PHONE_AGENT_CONVERSATIONAL_REFLEX=false
PHONE_AGENT_CONVERSATIONAL_REFLEX_COOLDOWN_MS=8000
DEEPGRAM_API_KEY=

# LLM provider: antigravity_gemini (100% free zero-key default), ollama,
# openrouter, openai, gemini, gemini_cli, or codex_app.
PHONE_AGENT_LLM_PROVIDER=antigravity_gemini
PHONE_AGENT_LLM_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
PHONE_AGENT_OLLAMA_PREWARM=false
PHONE_AGENT_OLLAMA_THINK=false
PHONE_AGENT_OLLAMA_TEMPERATURE=0.7
PHONE_AGENT_OLLAMA_TOP_P=0.8
PHONE_AGENT_OLLAMA_TOP_K=20
PHONE_AGENT_OLLAMA_MIN_P=0.0
PHONE_AGENT_OLLAMA_PRESENCE_PENALTY=0.0
OLLAMA_KEEP_ALIVE=-1
PHONE_AGENT_OLLAMA_NUM_PREDICT=192
PHONE_AGENT_OLLAMA_NUM_CTX=16384
PHONE_AGENT_OLLAMA_TURN_TIMEOUT_SECS=30

# Only the selected hosted provider needs its key.
# Keys placed here reach a foreground run. The installed LaunchAgent rebuilds its
# environment on every upgrade, so store a key the background service must keep in
# ~/.config/phone-agent/secrets.env (mode 0600, NAME=value per line); the runtime
# merges that file at startup and a real environment variable still overrides it.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_API_KEY=
# Google Gemini TTS only. Without it that voice falls back to the free Edge voice.
GEMINI_API_KEY=

# Optional: supported local Codex app-server using the existing ChatGPT login.
# This is a high-intelligence fallback, not the low-latency default.
# PHONE_AGENT_LLM_PROVIDER=codex_app
# PHONE_AGENT_LLM_MODEL=gpt-5.6-luna
CODEX_APP_SERVER_BINARY=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_REASONING_EFFORT=low
CODEX_TURN_TIMEOUT_SECS=30

PHONE_AGENT_TTS_PROVIDER=edge_tts
PHONE_AGENT_TTS_MODEL=edge-online-neural
PHONE_AGENT_TTS_VOICE=en-US-AvaNeural
PHONE_AGENT_TTS_AGGREGATION=phrase
PHONE_AGENT_TTS_MAX_BUFFER_DELAY_MS=80
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# High-quality no-key A/B candidate. This uses Microsoft's online Edge speech
# endpoint and therefore requires Internet access; it is not the offline fallback.
# PHONE_AGENT_TTS_PROVIDER=edge_tts
# PHONE_AGENT_TTS_MODEL=edge-online-neural
# PHONE_AGENT_TTS_VOICE=en-US-AndrewMultilingualNeural
# PHONE_AGENT_TTS_AGGREGATION=phrase
PHONE_AGENT_EDGE_TTS_RATE=+0%
PHONE_AGENT_EDGE_TTS_VOLUME=+0%
PHONE_AGENT_EDGE_TTS_PITCH=+0Hz
PHONE_AGENT_EDGE_TTS_FFMPEG_BINARY=ffmpeg
PHONE_AGENT_EDGE_TTS_PHRASE_MIN_CHARS=24
PHONE_AGENT_EDGE_TTS_PHRASE_MAX_CHARS=72
PHONE_AGENT_EDGE_TTS_CONNECT_TIMEOUT_SECS=5
PHONE_AGENT_EDGE_TTS_RECEIVE_TIMEOUT_SECS=20

# Safe local fallback, rendered on Metal through MLX. Sentence aggregation
# avoids clipped token fragments. bf16 measured ~18x realtime end to end on an
# M4 Max against ~4x for the retired ONNX build; kokoro-4bit is slower here but
# holds less memory. Use ff_siwis for French calls and an af_/am_/bf_/bm_ voice
# for English -- the voice prefix and the call language must agree.
# PHONE_AGENT_TTS_PROVIDER=kokoro
# PHONE_AGENT_TTS_MODEL=kokoro-bf16
# PHONE_AGENT_TTS_VOICE=af_heart
# PHONE_AGENT_TTS_AGGREGATION=sentence

# Which channel carries the call: the cellular bridge, or a WhatsApp voice call.
# The two share no resources and only one call runs at a time, so selecting
# WhatsApp cannot disturb the GSM path. WhatsApp must be paired once:
#   cd whatsapp_channel/rust_caller && ./build.sh
#   ../whatsapp-rust-caller pair-phone <your number> --country-code 212
PHONE_AGENT_CALL_CHANNEL=gsm
PHONE_AGENT_WHATSAPP_COUNTRY=212
PHONE_AGENT_WHATSAPP_MAX_SECS=900
# Optional overrides:
# PHONE_AGENT_WHATSAPP_BINARY=/absolute/path/to/whatsapp-rust-caller
# PHONE_AGENT_WHATSAPP_SESSION_DB=/secure/path/whatsapp-rust.db

# Unified Frappe CRM, Helpdesk and ERPNext integration. The one-command business-suite installer
# writes this private file and provisions its API credentials automatically.
PHONE_AGENT_FRAPPE_CONFIG=~/.config/phone-agent/frappe.json
